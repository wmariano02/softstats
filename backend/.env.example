APP_NAME="SoftStats CJB"
APP_ENV=local
APP_KEY=base64:2vYvD7aTjXg6Z8kL9qP3rS5uW1xY4aB8cD9eF0gH1iJ=
APP_DEBUG=true
APP_TIMEZONE=America/Santo_Domingo
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=softstats
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@softstats.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT
JWT_SECRET=base64:2vYvD7aTjXg6Z8kL9qP3rS5uW1xY4aB8cD9eF0gH1iJ=
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=3600

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8100
SANCTUM_ENCRYPT_COOKIES=true

# L5 Swagger
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

# Excel
EXCEL_CACHE_PATH=storage/excel_cache
